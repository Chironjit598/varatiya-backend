# ==============================================================
# Varatia Backend - Production Environment Variables Template
# ==============================================================

# Server Configuration
PORT=5001
NODE_ENV=production
CORS_ORIGIN=*

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.b27e8pj.mongodb.net/basha_lagbe?retryWrites=true&w=majority&authSource=admin

# JWT Authentication Secrets
JWT_SECRET=your_super_strong_production_jwt_secret_key_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_super_strong_production_jwt_refresh_secret_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# OTP Expiration Time (Minutes)
OTP_EXPIRY_MINUTES=5

# Email / SMTP Configuration (e.g. Gmail App Password or Brevo/Sendgrid)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="ভাড়াটিয়া (Varatia)" <your_email@gmail.com>

# Cloudinary Setup (For Image/Avatar/Property Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Push Notification (Optional: Single-line JSON or Base64 string of service account for cloud deployment)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"varatia-2cc12",...}
